{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OCI API Gateway deployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "path_prefix", "routes"],
  "properties": {
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$" },
    "path_prefix": { "type": "string", "pattern": "^/[A-Za-z0-9_\\-/]*$" },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "audiences", "jwks_uri"],
      "properties": {
        "issuer": { "type": "string" },
        "audiences": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "jwks_uri": { "type": "string", "pattern": "^https://" }
      }
    },
    "cors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_origins"],
      "properties": {
        "allowed_origins": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "allowed_methods": { "type": "array", "items": { "type": "string" } },
        "allowed_headers": { "type": "array", "items": { "type": "string" } },
        "exposed_headers": { "type": "array", "items": { "type": "string" } },
        "allow_credentials": { "type": "boolean" },
        "max_age_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 }
      }
    },
    "rate_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests_per_second"],
      "properties": {
        "requests_per_second": { "type": "integer", "minimum": 1 },
        "key": { "enum": ["CLIENT_IP", "TOTAL"] }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "methods", "backend"],
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "methods": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["ANY", "GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"] }
          },
          "anonymous": { "type": "boolean" },
          "scopes": { "type": "array", "items": { "type": "string" } },
          "backend": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "enum": ["http", "function", "stock"] } },
            "allOf": [
              {
                "if": { "properties": { "type": { "const": "http" } } },
                "then": {
                  "required": ["url"],
                  "additionalProperties": false,
                  "properties": {
                    "type": {},
                    "url": { "type": "string", "pattern": "^https?://" },
                    "connect_timeout_seconds": { "type": "number" },
                    "read_timeout_seconds": { "type": "number" },
                    "send_timeout_seconds": { "type": "number" }
                  }
                }
              },
              {
                "if": { "properties": { "type": { "const": "function" } } },
                "then": {
                  "required": ["function_id"],
                  "additionalProperties": false,
                  "properties": { "type": {}, "function_id": { "type": "string", "pattern": "^ocid1\\.fnfunc\\." } }
                }
              },
              {
                "if": { "properties": { "type": { "const": "stock" } } },
                "then": {
                  "required": ["status"],
                  "additionalProperties": false,
                  "properties": {
                    "type": {},
                    "status": { "type": "integer", "minimum": 100, "maximum": 599 },
                    "body": { "type": "string" },
                    "headers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["name", "value"],
                        "additionalProperties": false,
                        "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
